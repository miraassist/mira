[
  {
    "actions": [
      {
        "variables": {
          "before": "{{ state_attr('media_player.show_speaker', 'volume_level') }}",
          "until": "{{ (now() + timedelta(minutes=10)).isoformat() }}"
        }
      },
      {
        "if": [
          {
            "condition": "state",
            "entity_id": "media_player.show_speaker",
            "state": [
              "unavailable",
              "unknown"
            ]
          }
        ],
        "then": [
          {
            "action": "mira.send_message",
            "data": {
              "receiver": "anna",
              "text": "Dein Wecker morgen um 06:00 im Raum Schlafzimmer konnte nicht klingeln."
            }
          },
          {
            "stop": "the speaker cannot be reached"
          }
        ]
      },
      {
        "action": "media_player.volume_set",
        "data": {
          "volume_level": 0.9
        },
        "target": {
          "entity_id": "media_player.show_speaker"
        }
      },
      {
        "repeat": {
          "sequence": [
            {
              "action": "media_player.play_media",
              "data": {
                "announce": true,
                "media_content_id": "{{ 'http://homeassistant.local:8123/api/mira/panel/ui/sounds/wake_rise.mp3' if repeat.first else 'http://homeassistant.local:8123/api/mira/panel/ui/sounds/wake_loop.mp3' }}",
                "media_content_type": "music"
              },
              "target": {
                "entity_id": "media_player.show_speaker"
              }
            },
            {
              "timeout": "00:01:00",
              "wait_for_trigger": [
                {
                  "entity_id": "assist_satellite.show_assist_satellit",
                  "id": "reaction",
                  "to": "listening",
                  "trigger": "state"
                },
                {
                  "entity_id": "media_player.show_speaker",
                  "id": "round_over",
                  "to": "idle",
                  "trigger": "state"
                },
                {
                  "event_data": {
                    "automation": "mira_0123456789ab"
                  },
                  "event_type": "mira_alarm_cancel",
                  "id": "cancel",
                  "trigger": "event"
                }
              ]
            }
          ],
          "until": "{{ (wait.trigger is not none and wait.trigger.id in ['reaction', 'cancel']) or now() \u003e= as_datetime(until) }}"
        }
      },
      {
        "if": "{{ wait.trigger is not none and wait.trigger.id == 'cancel' }}",
        "then": [
          {
            "action": "media_player.media_stop",
            "target": {
              "entity_id": "media_player.show_speaker"
            }
          }
        ]
      },
      {
        "if": "{{ wait.trigger is not none and wait.trigger.id == 'reaction' }}",
        "then": [
          {
            "timeout": "00:02:00",
            "wait_for_trigger": [
              {
                "entity_id": "assist_satellite.show_assist_satellit",
                "to": "idle",
                "trigger": "state"
              }
            ]
          }
        ]
      },
      {
        "if": "{{ before is number }}",
        "then": [
          {
            "action": "media_player.volume_set",
            "data": {
              "volume_level": "{{ before }}"
            },
            "target": {
              "entity_id": "media_player.show_speaker"
            }
          }
        ]
      }
    ],
    "alias": "Wecker Schlafzimmer 456789ab",
    "conditions": [
      {
        "condition": "template",
        "value_template": "{{ now().strftime('%Y-%m-%d') == '2099-01-01' }}"
      }
    ],
    "description": "Mira: Wecker Schlafzimmer",
    "mode": "single",
    "triggers": [
      {
        "at": "06:00:00",
        "id": "ring",
        "trigger": "time"
      }
    ],
    "variables": {
      "mira_area": "schlafzimmer",
      "mira_date": "2099-01-01",
      "mira_days": "",
      "mira_kind": "alarm",
      "mira_owner": "anna",
      "mira_satellite": "assist_satellite.show_assist_satellit",
      "mira_speaker": "media_player.show_speaker",
      "mira_time": "06:00",
      "mira_title": "Wecker Schlafzimmer"
    }
  },
  {
